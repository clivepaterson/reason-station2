# syntax=docker/dockerfile:1

FROM maven:3.9.12-eclipse-temurin-25@sha256:4f82a03a7d6679281952d628131299b1be88d7030a49c6a2b7d2ba2642e44e3e AS maven

FROM ghcr.io/graalvm/native-image-community:25@sha256:0d936f32bb8acb5bc60c41b33e05f064d7a6aaf36b726538296c54949bd4a3c0 AS build
COPY --from=maven /usr/share/maven /usr/share/maven
ENV PATH="/usr/share/maven/bin:${PATH}"
WORKDIR /workspace

COPY pom.xml .
RUN mvn -B -ntp -Pnative dependency:go-offline
COPY src src
RUN mvn -B -ntp -Pnative native:compile \
    && mkdir /native \
    && cp target/reasonstation /native/ \
    && find target -maxdepth 1 -name '*.so' -exec cp {} /native/ \;

FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg wget libfreetype6 libfontconfig1 libxi6 libxrender1 libxtst6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 reasonstation \
    && useradd --uid 10001 --gid 10001 --no-create-home reasonstation

WORKDIR /app
COPY --from=build --chown=10001:10001 /native/ /app/

USER 10001:10001
EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://127.0.0.1:8080/actuator/health/liveness || exit 1

# Leave memory outside the Java heap for native allocations and the FFmpeg worker.
ENTRYPOINT ["/app/reasonstation", "-Xmx768m", "-Djava.awt.headless=true"]
